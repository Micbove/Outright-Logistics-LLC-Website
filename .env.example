DATABASE_URL="file:./dev.db"

# Initial admin seed (used by `prisma/seed.ts`)
# Admin is created if it does not already exist.
ADMIN_EMAIL="admin@example.com"
ADMIN_TEMP_PASSWORD="change-me-now-please"

# Vercel note:
# Vercel serverless filesystems are read-only except `/tmp`.
# If you still want SQLite for a short-lived demo, set:
# DATABASE_URL="file:/tmp/dev.db"

